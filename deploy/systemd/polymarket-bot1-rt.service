[Unit]
Description=Polymarket bot 1 temps réel — boucle METAR + finance_engine_rt (deploy/bot1_rt_daemon.sh)
Documentation=file:__REPO_ROOT__/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_AS_USER__
Group=__RUN_AS_USER__
WorkingDirectory=__REPO_ROOT__

Environment=BOT1_RT_CYCLE_INTERVAL_SEC=300

ExecStart=__REPO_ROOT__/deploy/bot1_rt_daemon.sh

Restart=always
RestartSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
