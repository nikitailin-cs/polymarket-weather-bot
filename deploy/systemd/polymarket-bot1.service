[Unit]
Description=Polymarket bot1 — boucle NOAA + finance_engine (deploy/bot1_daemon.sh)
Documentation=file:__REPO_ROOT__/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_AS_USER__
Group=__RUN_AS_USER__
WorkingDirectory=__REPO_ROOT__

# Variables optionnelles (voir README)
Environment=BOT1_CYCLE_INTERVAL_SEC=900
Environment=NOMADS_ALLOW_OUTSIDE_WINDOW=1
Environment=NOMADS_FORCE=0
Environment=BOT1_REFRESH_ACTIVE_MARKETS_FROM_GAMMA=1
Environment=BOT1_MARKET_SCAN_LIMIT=500
Environment=BOT1_FAIL_ON_MARKET_SCAN_ERROR=0

ExecStart=__REPO_ROOT__/deploy/bot1_daemon.sh

Restart=always
RestartSec=30

# Logs aussi dans logs/bot1_daemon.log ; journalctl -u polymarket-bot1 -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
