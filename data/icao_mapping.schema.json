{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymarket.local/schemas/icao_mapping.schema.json",
  "title": "icao_mapping",
  "description": "Objet racine : clés = condition_id Polymarket ; valeurs = liaison OACI, seuil, fuseau. Jour unique : target_date. Plage : target_date_start + target_date_end (inclus), lu par produce_rt_signals.",
  "type": "object",
  "$defs": {
    "marketSpec": {
      "type": "object",
      "required": ["icao", "threshold", "timezone"],
      "anyOf": [
        { "required": ["target_date"] },
        { "required": ["target_date_start", "target_date_end"] }
      ],
      "additionalProperties": true,
      "properties": {
        "icao": {
          "type": "string",
          "minLength": 3,
          "description": "Code OACI (ex. KJFK)."
        },
        "threshold": {
          "type": "number",
          "description": "Seuil numérique (ex. 80.0), unité via threshold_unit."
        },
        "threshold_unit": {
          "type": "string",
          "description": "F ou C (le code accepte aussi FAHRENHEIT / CELSIUS)."
        },
        "yes_if_above": {
          "type": "boolean",
          "description": "Marché « au-dessus » du seuil si true."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "IANA (ex. America/New_York)."
        },
        "deadline_local_hhmm": {
          "type": "string",
          "description": "Heure locale limite pour le régime « mort » (ex. 23:50)."
        },
        "dead_min_gap": {
          "type": "number",
          "minimum": 0,
          "description": "Écart minimal (degrés) après deadline pour p_win=0."
        },
        "target_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Jour calendaire unique (YYYY-MM-DD) vs date locale, si pas de plage start/end."
        },
        "target_date_start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Début de plage (inclus) ; exiger aussi target_date_end."
        },
        "target_date_end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Fin de plage (inclus) avec target_date_start."
        },
        "weather_variable": {
          "type": "string",
          "description": "temp_max | temp_min | temp_avg (défaut temp_max dans produce_rt_signals)."
        },
        "range_scalp_mode": {
          "type": "string",
          "description": "Plage uniquement : every_day_in_range | first_day_only | last_day_only (défaut every_day_in_range)."
        },
        "metar_interpretation": {
          "type": "string",
          "description": "metar_instant | proxy_daily_high | document_only (voir core.rt_polymarket_alignment)."
        },
        "observation_interpretation": {
          "type": "string",
          "description": "Alias optionnel de metar_interpretation."
        },
        "resolution_notes": {
          "type": "string",
          "description": "Notes libres (avertissement log si présent)."
        }
      }
    }
  },
  "patternProperties": {
    "^_": {
      "type": "object",
      "description": "Clés réservées (commentaires) — ignorées par produce_rt_signals."
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/marketSpec"
  }
}
