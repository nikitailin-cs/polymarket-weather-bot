# Copier vers .env et remplir les valeurs (ne jamais committer .env)

# Polymarket / Polygon
PRIVATE_KEY=

# Scanner
MAX_RESULTS=100
SLEEP_SEC=0.05
MIN_VOLUME=500
MIN_DAYS_EXPIRY=1

# Météo
OWM_API_KEY=
WEATHER_REFRESH_SEC=300
TOMORROW_API_KEY=
WEATHERAPI_KEY=

# Risque
MIN_EDGE=0.05
MAX_BET_USD=20.0
MAX_PORTFOLIO_USD=150.0
KELLY_FRACTION=0.25
MAX_DRAWDOWN_PCT=0.30

# Telegram (optionnel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logs
LOG_LEVEL=INFO

# 1 = simulation, 0 = ordres réels
DRY_RUN=1

# Notebooks / outils (optionnel)
# DUNE_API_KEY=
# CDSAPI_KEY=
