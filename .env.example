# Copier vers .env et remplir les valeurs (ne jamais committer .env)

# Polymarket / Polygon
PRIVATE_KEY=
PUBLIC_ADDRESS=
POLYGON_RPC_URL=

# Scanner
MAX_RESULTS=100
SLEEP_SEC=0.05
MIN_VOLUME=500
MIN_DAYS_EXPIRY=1

# Météo
OWM_API_KEY=
WEATHER_REFRESH_SEC=300
TOMORROW_API_KEY=
WEATHERAPI_KEY=

# Risque
MIN_EDGE=0.05
MAX_BET_USD=20.0
MAX_PORTFOLIO_USD=150.0
KELLY_FRACTION=0.25
MAX_DRAWDOWN_PCT=0.30

# Telegram (optionnel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logs
LOG_LEVEL=INFO

# 1 = simulation, 0 = ordres réels
DRY_RUN=1

# main.py : log unique style ancien print déploiement (optionnel)
# MAIN_DEPLOY_BANNER=1

# Bot1 NOAA / finance / settlement — chemins optionnels (défaut = sous data/).
# main_compartment.py --bot 1 définit automatiquement un compartiment data/bots/bot_1/.
# TRADING_SIGNALS_FILE=data/trading_signals.json
# TRADING_SIGNALS_META_FILE=data/trading_signals_meta.json
# PORTFOLIO_SQLITE_PATH=data/portfolio.sqlite
# NOAA_WATCHDOG_STATE_PATH=data/logs/noaa_watchdog_state.json
# LAST_NOAA_RUN_FILE=data/last_noaa_run.json

# Bot1 — sigma pour P(win) gaussien (voir bots/bot1/MODEL_SCIENCE.md)
# BOT1_PROB_SIGMA=1.5
# BOT1_PROB_SIGMA_TEMPS=1.5
# BOT1_PROB_SIGMA_PRECIP=5.0
# BOT1_USE_BIAS_STD_FOR_SIGMA=1

# Notebooks / outils (optionnel)
# DUNE_API_KEY=
# CDSAPI_KEY=

# METAR.ws push stream (bots/metar_ws/metar_ws_daemon.py) — see docs in deploy/systemd/README.md
# METAR_SOURCE=awc            # awc (poll aviationweather.gov, default) | metar_ws (snapshot from the daemon)
# METAR_WS_API_KEY=           # mts_live_... — never commit the real key
# METAR_WS_URL=wss://stream.metar.ws/v1/ws
# METAR_WS_CA_BUNDLE=            # PEM bundle; default certifi (fixes 'certificate has expired' on Windows stores)
# METAR_WS_CHANNEL_FORMAT=metar.obs.{icao}     # one channel per resolution station, see data/metar_ws_stations.json
# METAR_WS_CHANNEL_MAP={"EGLL":"metar.obs.eglc"}   # per-station overrides, optional
# METAR_WS_SNAPSHOT_FILE=data/bots/realtime/metar_ws_latest.json
# METAR_WS_SNAPSHOT_MAX_AGE_SEC=180
# METAR_WS_OBS_MAX_AGE_SEC=7200
# METAR_WS_FALLBACK_AWC=0     # 1 = poll AWC for stations missing from the snapshot
# METAR_WS_TRIGGER_CMD=bash update_bot_rt.sh   # run a cycle on every live report (push mode)
# METAR_WS_TRIGGER_DEBOUNCE_SEC=5
# METAR_WS_TRIGGER_ON_SPECI_ONLY=0
# SOURCES=metar_ws              # comma-separated data sources: metar_ws, awc_poll
# METAR_WS_FORECASTS=1          # also subscribe to metar.forecast.basic/hires.<icao> (model max/min per local day)
# METAR_WS_OBS10=1              # also subscribe to metar.obs10.<icao> (5-10 min observations, leading indicator only)
# AWC_POLL_SEC=120              # awc_poll source interval
# FORECAST_SIGMA_HIRES_C=1.3    # model error assumed for hires models (HRRR, NBM, ICON-D2, ...)
# FORECAST_SIGMA_BASIC_C=1.9    # ... for basic models (GFS, ICON, ECMWF)
# Strategy parameters: config/strategies.json (STRATEGIES_CONFIG=path to override); FINANCE_RT_* below still win
# FINANCE_RT_PROB_TRADING=0     # = strategies.forecast_edge.enabled
# FINANCE_RT_PROB_MIN_EDGE=0.08
# FINANCE_RT_MAX_PROB_TARGETS=15
# FINANCE_RT_L2_WORKERS=8        # parallel CLOB /book reads
# RUN_CYCLE_STEP_TIMEOUT_SEC=150 # run_cycle.py kills a step that runs longer (rc 124)

# Ops dashboard (python -m ui.server) — read-only
# UI_HOST=127.0.0.1
# UI_PORT=8765
# UI_TOKEN=                   # required when UI_HOST is not loopback
# UI_POLYMARKET_PRICES=1      # 0 = no Gamma API lookups

# Paper trading (DRY_RUN=1 + PAPER_TRADING=1): simulated fills + settlement via Gamma, no wallet needed
# PAPER_TRADING=1
# BOT2_PORTFOLIO_PAPER_SQLITE_PATH=data/bots/bot_2_realtime/portfolio_paper.sqlite
# UPDATE_BOT_RT_SKIP_SETTLEMENT=0   # run_cycle.py settles paper positions; the on-chain chain is not run there
# PYTHON_BIN=python                 # update_bot_rt.sh: interpreter override (Windows / git-bash)
